 "evidence": {
  "ev_swaddling": {
   "name": "襁褓残片",
   "img": "ev_swaddling",
   "desc": "随身带了三十七年。角上半个闭眼纹，绣着名字 EDRIC（埃德里克）。院长说：1312 年冬至夜，我被放在灰烛修道院门口，约莫三周大。"
  },
  "ev_rattle": {
   "name": "银摇铃",
   "img": "ev_rattle",
   "desc": "老领主攥在手心的银摇铃。铃柄刻着 MCCCXII · XII · III，和一只闭着的眼。"
  },
  "ev_prayer_book": {
   "name": "老领主的祷告簿",
   "img": "ev_prayer_book",
   "desc": "三十七年，每一页都是同一段祷词：“我把我第一个儿子的名字交给了井。我想不起它，只记得他母亲绣的第一针是一个 E。”"
  },
  "ev_aelind_letter": {
   "name": "艾琳德的信",
   "img": "ev_aelind_letter",
   "desc": "“他们说冬至那夜要带走我们第一个孩子的名字。那我就把名字缝进布里——线比墨长久。我每晚给他唱：线轴转，银铃响，小羊睡，月亮闭眼。若有一天他回来，让他唱给育婴室的门听。”——艾琳德，MCCCXII 年降临节。"
  },
  "ev_family_portrait": {
   "name": "戈德温一家（1312）",
   "img": "ev_family_portrait",
   "desc": "灰漆下是艾琳德怀里的婴儿：襁褓角上半个闭眼纹，手里攥着银摇铃。他们身后站着持牧杖的神父，左眼下一颗泪痣。"
  },
  "ev_ageless_priest": {
   "name": "不老的神父",
   "img": "ev_ageless_priest",
   "desc": "1238 年先祖身后、1275 年罗泽琳一家身后、1312 年戈德温身后，站着同一个神父：同一颗泪痣，一天也没老。"
  },
  "ev_cloth_match": {
   "name": "补全的家徽",
   "img": "ev_cloth_match",
   "desc": "我的襁褓残片和育婴室绣绷上的布，撕口严丝合缝。它出自这间育婴室，出自艾琳德的手。"
  },
  "ev_baptism_record": {
   "name": "受洗记录",
   "img": "ev_baptism_record",
   "desc": "“MCCCXII 年 XII 月 III 日生，戈德温与艾琳德之长子，冬至前受洗，名 E▇▇▇▇。主礼：塞弗林。”名字只剩第一个字母。"
  },
  "ev_severin_confession": {
   "name": "塞弗林的供述",
   "img": "ev_severin_confession",
   "desc": "“我抱进井室的是一卷空襁褓……井吃下了‘埃德里克’，世上却还剩一个叫这个名字的身体。它等了你三十七年。”"
  }
 },
