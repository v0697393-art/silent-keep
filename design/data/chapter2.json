 "texts": {
  "t_r4_mirror": "铜镜里的人有一双灰眼睛，和帐幔里那位老人一模一样。我摸出随身带了三十七年的旧襁褓残片：角上半个闭眼纹，绣着一个名字——<k>EDRIC</k>。第一个字母的针脚比别的都密。",
  "t_r4_mirror_again": "镜子里还是那双灰眼睛。我开始不喜欢照镜子了。",
  "t_r4_washstand": "盥洗架上的水罐冻透了，锡杯底也结着一层冰。我把杯子拿上。",
  "t_r4_washstand_empty": "水罐里的冰裂成一张脸的形状。只是裂纹。",
  "t_r4_ice_melt": "炭火舔着杯底，冰化成了温水。",
  "t_r4_bed": "老领主戈德温在帐幔里咳嗽，右手攥着什么不放，嘴唇干裂：“水……别把他的……名字……”",
  "t_r4_bed_drink": "他喝下温水，呼吸慢慢平稳，攥紧的手松开了：掌心里是一只小小的银摇铃。铃柄上刻着 <k>MCCCXII · XII · III</k>，和一只闭着的眼。",
  "t_r4_bed_again": "老人又咳了一阵，干裂的嘴唇一直在动：“水……”",
  "t_r4_bed_sleep": "老人睡着了，手指还在被面上一下一下地数着什么。",
  "t_r4_priedieu": "祈祷台上摊着一本祷告簿。每一页都是同一段祷词：“主啊，我把我第一个儿子的名字交给了井。我想不起它了，只记得他母亲绣襁褓时，第一针绣的是一个 <k>E</k>。”整整三十七年。",
  "t_r4_priedieu_again": "祷词的墨色从褐到黑，一年比一年写得用力。",
  "t_r4_coffer_locked": "床头的铁匣上有四个转轮，匣盖刻着：<k>“长子降生之日，月在前，日在后。”</k>我还不知道这家的长子是哪天生的。",
  "t_r4_coffer_ready": "“长子降生之日，月在前，日在后。”……那只银摇铃上刻着一个日子。",
  "t_r4_coffer_open": "匣里是一把长廊钥匙，还有一封折了很多遍的信。是艾琳德写给丈夫的，从没寄出去。",
  "t_r4_coffer_empty": "铁匣空了，底部有一圈指甲划出来的痕迹。",
  "t_r4_window": "窗上的霜花长成了蕨叶的形状。",
  "t_r4_door_locked": "通往长廊的门锁着。",
  "t_r4_door_blocked": "阿尔里克横跨一步挡在门前：“那是我家的长廊。先回答我，你到底是谁？”",
  "t_alric_after": "阿尔里克盯着父亲松开的手，很久没有说话。",
  "t_alric_intro": "阿尔里克：“你从井里爬出来，嘴里念着一个我们家不许念的名字。说吧，外乡人，你想要什么？”",
  "t_alric_s1": "我是莫尔德雷克家的长子。在我之前，父亲没有过别的孩子。",
  "t_alric_near_cloth": "“一块旧布？沼地上每个弃婴身上都裹着一块。”看来得拿出这个家里自己的东西。",
  "t_alric_b1": "他盯着铃柄看了很久：“MCCCXII，是 1312 年。我生于 <k>1315</k> 年。这只铃……比我还早三年。”",
  "t_alric_s2": "我母亲艾琳德只生过我一个。生下我那年冬天，她就病死了。",
  "t_alric_b2": "“这是她的字……‘我们第一个孩子’。”他的声音低下去，“她从没提过。也许提过，是我忘了。”",
  "t_alric_p1": "就算我真有过一个哥哥，也和你这个外人无关。",
  "t_alric_b3": "他接过那块布，手指停在针脚上：“这种回针……我小时候的毯子也是这么缝的，是母亲的针法。”他把门让了出来：“她的画像在长廊。去看吧，别让神父看见。”",
  "t_wrong_evidence": "对方一脸迷惑。埃德里克自嘲：这可拆穿不了什么。",
  "t_r5_founder": "先祖埃尔温·莫尔德雷克，1238。他闭着眼。身后的阴影里站着一个持牧杖的神父，<k>左眼下一颗泪痣</k>。",
  "t_r5_founder_again": "先祖的眼皮画得很薄，像随时会睁开。",
  "t_r5_ageless": "1238 年站在先祖身后的神父，和 1312 年站在戈德温身后的，是同一张脸、同一颗泪痣。七十四年，他一天也没老。",
  "t_r5_rozelyn": "1275 年的全家像。画里小女孩的脸只是一块空白的底色，名牌写着罗泽琳。角落里又是那个神父，左眼下一颗痣。",
  "t_r5_rozelyn_again": "空白的脸上落了一层灰，灰上有一道指印，像有人想替她把脸擦出来。",
  "t_r5_family": "《戈德温与艾琳德，MCCCXII》。艾琳德的双臂弯成抱孩子的姿势，臂弯里却是一块颜色更新的灰漆。名牌上第三个名字被刮掉了。",
  "t_r5_family_restore": "松脂油化开了灰漆。艾琳德怀里是一个裹着襁褓的婴儿，襁褓角上绣着半个闭眼纹，小手攥着一只银摇铃。他们身后站着持牧杖的神父，左眼下一颗痣。",
  "t_r5_family_again": "画里的婴儿还在看着母亲。不，是在看着我。",
  "t_r5_easel": "画架上是一幅没画完的小像：玛蒂尔。她身后被人用炭笔添了一个高个子，没有脸，却披着一件旅行斗篷——和我身上这件一样。画架下有一瓶松脂油和几块破布，我拿上了。",
  "t_r5_easel_again": "斗篷的下摆，她画得很仔细，连我补过的那块都画上了。",
  "t_r5_board": "一个空画框，画像不知被谁取走了。正好用来钉线索。",
  "t_r5_door_locked": "尽头是一扇刷过白漆的矮门。门上四块木牌可以转动，刻着月亮、小羊、银铃、线轴。门楣上写着：<k>“为长子唱的歌。”</k>我还不知道这家的长子是谁。",
  "t_r5_door_ready": "为长子唱的歌……艾琳德的信里写过那首歌。",
  "t_bloodline_done": "线全连上了：1312 年冬至被献名的，是戈德温与艾琳德的长子，阿尔里克的哥哥。他的名字以 <k>E</k> 开头。",
  "t_c2_wrong_link": "红线绷断了。埃德里克揉了揉眉心：不对。",
  "t_dd_who_q": "1312 年冬至被献出名字的婴儿，是谁？",
  "t_r6_cradle": "橡木摇篮，床头刻着：“此处安睡着我们的长子。”下面一排五个字母槽，全是空的，只有第一个槽里还留着一个浅浅的 <k>E</k>。若我在缮写室没有看错，家谱 1312 那一行刮剩的，也是这个字母。摇篮底座有个带五个转轮的小抽屉，抽屉面上刻着：<k>“把他的名字排好，读出它们的数。”</k>",
  "t_r6_drawer_ready": "五个转轮。“把他的名字排好，读出它们的数。”——地上那些积木。",
  "t_r6_record": "抽屉里是一页受洗记录：“MCCCXII 年 XII 月 III 日生，戈德温与艾琳德之<k>长子</k>，冬至前受洗，名 E▇▇▇▇。主礼：塞弗林。”名字只剩第一个字母。主礼人的签名，墨色新得像昨天才写。",
  "t_r6_cradle_again": "抽屉面上的字：“把他的名字排好，读出它们的数。”五个转轮，五个空槽。",
  "t_r6_cradle_after": "床头那排空槽里，第一个 E 好像比刚才深了一点。",
  "t_r6_cradle_notyet": "我把襁褓贴近床头，针脚在发烫。还不是时候，我得先弄清楚它为什么会在我身上。",
  "t_r6_blocks": "七块木积木，正面各刻一个字母，侧面画着一个数：<k>A·2　L·8　E·3　D·7　R·1　I·9　C·4</k>。七个字母，正好够拼出两个名字。",
  "t_r6_blocks_again": "积木底下刻着一行小字：“给我们的孩子们。”是复数。",
  "t_r6_basket": "针线篮里的绣绷上绷着一块没绣完的襁褓布，绣着家徽另外三格：静水、沉钥、井。左上角被撕掉了一块。",
  "t_r6_cloth_match": "我把随身那块残片按上去。撕口严丝合缝，闭眼纹补全了家徽。三十七年，它一直在等这一角。",
  "t_r6_basket_after": "补全的家徽躺在绣绷上。针还别在布边，好像她只是出去一下。",
  "t_r6_mobile": "摇篮上方吊着一圈木雕月亮，每一枚都闭着眼。",
  "t_r6_mobile_again": "木月亮转得很慢，没有风。",
  "t_severin_intro": "塞弗林神父坐在乳母的椅子上，用脚尖轻轻推着空摇篮。他看上去五十岁，也可能一百五十岁。“寻踪人。我等你很久了，比你以为的还要久。”",
  "t_severin_s1": "1312 年冬至，那孩子的名字和身体一起走进了井里。我亲眼看着的。",
  "t_severin_near_cloth": "“灰烛修道院门口捡来的布，”他微笑，“每一块都像谁的襁褓。”得证明这块布出自这间屋子。",
  "t_severin_b1": "他的脚停了，摇篮还在晃。“……她把孩子从我手里换走了。我抱进井室的，是一卷空襁褓。”",
  "t_severin_s2": "“塞弗林”是这座礼拜堂神父的职名。我是第四个叫这个名字的人，来这里不过三十年。",
  "t_severin_b2": "“一颗痣。”他摸了摸左眼下，“画师们总是太仔细。”他第一次没有笑。“我早就没有自己的名字了，寻踪人。我把它也交了出去，换来看守这口井。”",
  "t_severin_s3": "老爷是自愿的。孩子是他亲手交给我的，这个家里没有一个人反对。",
  "t_severin_b3": "“艾琳德。”他念这个名字，像在念一行要刮掉的字，“她反对。她缝了一整夜，那一针一针，比我的经文还难拆。”",
  "t_severin_p1": "可你凭什么说，那个孩子就是你？",
  "t_severin_near_p1": "“一个名字而已。北海边上叫埃德里克的人，不止一个。”我需要一份写着日子的记录。",
  "t_severin_confess": "他看着受洗记录上残存的 E，又看看我。“XII 月 III 日生，冬至前受洗。那年冬至夜，灰烛修道院门口多了一个三周大的婴儿。”他站起身，椅子还在摇。“井吃下了‘埃德里克’，世上却还剩一个叫这个名字的身体。它等了你三十七年。欢迎回家，莫尔德雷克家的长子。”",
  "t_severin_gone": "乳母的椅子空着，还在轻轻摇。楼梯上传来牧杖点地的声音，一路往下，往井的方向去了。",
  "t_dd_c2_q1": "1312 年冬至被献名的婴儿，父母是谁？",
  "t_dd_c2_q2": "那个婴儿为什么没有随名字一起走进井里？",
  "t_dd_c2_q3": "那个婴儿如今在哪里？",
  "t_hint_c2_portrait": "长廊里那幅被涂掉的全家像，抱着孩子的是谁？",
  "t_hint_c2_letter": "艾琳德的信：线比墨长久。神父也承认，他抱进井室的是一卷空襁褓。",
  "t_hint_c2_record": "受洗记录上的生日，修道院门口的日子，对一对。",
  "t_c2_dd_solved": "我不是被丢掉的，我是被藏起来的。我的名字叫埃德里克，我是这家的长子。",
  "t_c2_dd_wrong": "推理接不上。埃德里克把证据重新摊开。",
  "t_cs_c2_intro_1": "井盖合上之前，那个声音又说了一遍：“欢迎回家。”我爬出墓穴时，火把已经围了上来。",
  "t_cs_c2_intro_2": "举火把的男人自称阿尔里克·莫尔德雷克，这座城堡的继承人。“父亲醒了，”他说，“他听见了你的名字。”",
  "t_cs_c2_intro_3": "领主寝室里，老人从帐幔间伸出一只手，抓住的却是空气：“埃德里克……别把他的名字……”",
  "t_cs_c2_end_1": "线从襁褓里爬出来，一针一针，把五个字母缝回床头的空槽：E、D、R、I、C。",
  "t_cs_c2_end_2": "长廊里，画中母亲怀里的婴儿睁开了眼睛。灰色的，和我的一样。",
  "t_cs_c2_end_3": "墓穴深处，塞弗林对着井口低声说：“长子回来了。三十七年前欠下的那一份，可以收齐了。”井用我的声音，念出一个完整的名字：埃德里克·莫尔德雷克。",
  "t_ch2_ending_title": "第二章 · 血脉　完"
 },
